{
  "info": {
    "name": "Server_Web Product CRUD API",
    "description": "Run in order against your local server. Creation saves productId for later requests. The delete request removes the test product.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Success flag matches status\", () => pm.expect(pm.response.json().success).to.eql(true));",
              "pm.test(\"Database connected\", () => pm.expect(pm.response.json().database).to.eql(\"connected\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create Product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Wireless Mouse\",\n  \"description\": \"Bluetooth wireless mouse\",\n  \"price\": 799,\n  \"category\": \"Electronics\",\n  \"inStock\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Success flag matches status\", () => pm.expect(pm.response.json().success).to.eql(true));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"productId\", pm.response.json().data._id);",
              "pm.test(\"Created product\", () => pm.expect(pm.response.json().data.name).to.eql(\"Wireless Mouse\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Get All Products",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Success flag matches status\", () => pm.expect(pm.response.json().success).to.eql(true));",
              "pm.test(\"Returns a list\", () => pm.expect(pm.response.json().data).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Get Product By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Success flag matches status\", () => pm.expect(pm.response.json().success).to.eql(true));",
              "pm.test(\"ID matches\", () => pm.expect(pm.response.json().data._id).to.eql(pm.collectionVariables.get(\"productId\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Update Product",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": 699,\n  \"inStock\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Success flag matches status\", () => pm.expect(pm.response.json().success).to.eql(true));",
              "pm.test(\"Price updated\", () => pm.expect(pm.response.json().data.price).to.eql(699));",
              "pm.test(\"Stock updated\", () => pm.expect(pm.response.json().data.inStock).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Missing Price",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Invalid Product\",\n  \"description\": \"Missing required price\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Success flag matches status\", () => pm.expect(pm.response.json().success).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Invalid ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products/not-an-id"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Success flag matches status\", () => pm.expect(pm.response.json().success).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Missing Product",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products/000000000000000000000001"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"Success flag matches status\", () => pm.expect(pm.response.json().success).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Delete Product",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Success flag matches status\", () => pm.expect(pm.response.json().success).to.eql(true));",
              "pm.test(\"Deleted correct product\", () => pm.expect(pm.response.json().deletedId).to.eql(pm.collectionVariables.get(\"productId\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Verify Deletion",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"Success flag matches status\", () => pm.expect(pm.response.json().success).to.eql(false));"
            ]
          }
        }
      ]
    }
  ]
}
